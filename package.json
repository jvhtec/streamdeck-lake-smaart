{
  "name": "com.jvhtec.lake-smaart",
  "version": "1.0.0",
  "description": "Stream Deck plugin for Lake LM and Smaart",
  "scripts": {
    "build": "tsc",
    "la:mock": "node scripts/mock-la-http.js",
    "la:smoke": "npm run build && node scripts/la-smoke.js",
    "test:la": "npm run build && node --test tests/la/**/*.test.js",
    "test:lake": "npm run build && node --test tests/lake/**/*.test.js",
    "test:core": "npm run build && node --test tests/core/**/*.test.js",
    "test:smaart": "npm run build && node --test tests/smaart/**/*.test.js",
    "lake:mock": "node scripts/mock-lake-dlm.js",
    "lake:selftest": "node scripts/lake-selftest.js",
    "postbuild": "node scripts/copy-runtime-deps.mjs",
    "watch": "tsc -w"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0"
  }
}
